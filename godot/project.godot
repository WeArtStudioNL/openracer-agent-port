; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="O-Racer Godot"
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Content="*res://scripts/content.gd"
RunLog="*res://scripts/run_log.gd"
Settings="*res://scripts/settings.gd"
Controls="*res://scripts/controls.gd"
WheelInput="*res://scripts/wheel_input.gd"
ForceFeedback="*res://scripts/force_feedback.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[debug]

file_logging/enable_file_logging=true
file_logging/enable_file_logging.pc=true
file_logging/max_log_files=30

[input_devices]

joypads/ignore_joypad_on_unfocused_application=false

[physics]

common/physics_ticks_per_second=120
3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[rendering]

textures/vram_compression/import_etc2_astc=true

anti_aliasing/quality/msaa_3d=2
