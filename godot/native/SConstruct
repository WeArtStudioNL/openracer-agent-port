#!/usr/bin/env python
# Builds the native part of O-Racer (a GDExtension) into godot/bin/.
#
#   cd godot/native && scons                      (debug, for the editor)
#   cd godot/native && scons target=template_release
#
# godot-cpp is a submodule (git submodule update --init). The API of Godot 4.7 is read from extension_api.json
# when it is there (Godot --headless --dump-extension-api), otherwise the one that comes with godot-cpp is used.
import os

if os.path.exists("extension_api.json"):
    ARGUMENTS.setdefault("custom_api_file", "extension_api.json")

env = SConscript("godot-cpp/SConstruct")
env.Append(CPPPATH=["src/"])
# the force feedback calls the HID functions of the SDL3 inside Godot (taken at run time); only the headers of SDL3
# are needed to build (on macOS: brew install sdl3)
env.Append(CPPPATH=["/opt/homebrew/opt/sdl3/include", "/usr/local/opt/sdl3/include", "/usr/include"])
sources = Glob("src/*.cpp")

suffix = env["suffix"]
if env["platform"] == "macos":
    library = env.SharedLibrary("../bin/liboracer{}.dylib".format(suffix), source=sources)
else:
    library = env.SharedLibrary("../bin/liboracer{}{}".format(suffix, env["SHLIBSUFFIX"]), source=sources)

Default(library)
