[configuration]

entry_symbol = "oracer_library_init"
compatibility_minimum = "4.5"
reloadable = true

[libraries]

macos.debug = "res://bin/liboracer.macos.template_debug.universal.dylib"
macos.release = "res://bin/liboracer.macos.template_release.universal.dylib"
linux.debug.x86_64 = "res://bin/liboracer.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/liboracer.linux.template_release.x86_64.so"
windows.debug.x86_64 = "res://bin/liboracer.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/liboracer.windows.template_release.x86_64.dll"
