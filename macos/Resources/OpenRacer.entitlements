<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- OpenRacer is given out as a DMG (openracer.eu, itch.io), signed with Developer ID and notarized, not through the App Store:
	     no sandbox, so the game reads racing wheels and sends them force feedback (IOHIDManager) and may start ffmpeg. The hardened
	     runtime is on (project.yml), as notarization asks; the game needs none of its exceptions (the JavaScript runs in the web
	     content process of WebKit, which has its own). -->
</dict>
</plist>
